<!DOCTYPE html><html class="scroll-smooth" lang="fr" style=""><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Simulation Vidéo 3D Fœtale — Évolution Bébé Semaine par Semaine</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script>
tailwind.config = {
    theme: {
        extend: {
            colors: {
                cream: '#FAF7F2',
                sand: '#F3ECE1',
                ivory: '#FFFDF9',
                mocha: '#4A3B32',
                'mocha-light': '#7D6A5D',
                bronze: '#C08A3E',
                'bronze-light': '#D4A360',
                'bronze-dark': '#8F5C1B',
                champagne: '#EFE3D3',
                rose: '#E8D3C9',
                softblue: '#D2DDE6'
            },
            fontFamily: {
                serif: ['"Playfair Display"', 'Georgia', 'serif'],
                sans: ['"Plus Jakarta Sans"', 'sans-serif']
            },
            animation: {
                'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                'heartbeat': 'heartbeat 1.1s ease-in-out infinite',
                'float': 'float 6s ease-in-out infinite',
                'wave': 'wave 1.2s ease-in-out infinite alternate',
                'fetal-breath': 'fetalBreath 4.5s ease-in-out infinite alternate',
                'amniotic-wave': 'amnioticWave 8s ease-in-out infinite alternate'
            },
            keyframes: {
                heartbeat: {
                    '0%, 100%': { transform: 'scale(1)' },
                    '15%': { transform: 'scale(1.15)' },
                    '30%': { transform: 'scale(1.02)' },
                    '45%': { transform: 'scale(1.12)' },
                    '60%': { transform: 'scale(1)' }
                },
                float: {
                    '0%, 100%': { transform: 'translateY(0px)' },
                    '50%': { transform: 'translateY(-8px)' }
                },
                fetalBreath: {
                    '0%': { transform: 'scale(1)' },
                    '100%': { transform: 'scale(1.028)' }
                },
                amnioticWave: {
                    '0%': { filter: 'brightness(1.02) contrast(1.02) hue-rotate(0deg)' },
                    '50%': { filter: 'brightness(1.07) contrast(1.05) hue-rotate(2deg)' },
                    '100%': { filter: 'brightness(1.02) contrast(1.02) hue-rotate(0deg)' }
                },
                wave: {
                    '0%': { height: '4px' },
                    '100%': { height: '16px' }
                }
            }
        }
    }
}
</script>
<style>
.custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
.custom-scrollbar::-webkit-scrollbar-track { background: #F3ECE1; border-radius: 9999px; }
