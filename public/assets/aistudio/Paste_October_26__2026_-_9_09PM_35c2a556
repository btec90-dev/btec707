<div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-md w-11/12 bg-mocha/95 text-ivory backdrop-blur-md px-4 py-3 rounded-2xl border border-bronze/40 shadow-2xl flex items-start gap-3 transition-all duration-300 transform opacity-100 translate-y-0" id="audioToast">
