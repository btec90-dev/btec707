        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-amber-300 text-xs sm:text-sm">straighten</span>
          <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-gray-300">Taille :</span>
