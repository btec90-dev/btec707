function dismissAudioToast() {
    const toast = document.getElementById("audioToast");
    if (toast) {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
    }
}

function unlockAudio() {
    try {
        if (!audioCtx) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (AudioContextClass) {
                audioCtx = new AudioContextClass();
                masterGainNode = audioCtx.createGain();
                masterGainNode.gain.setValueAtTime(0.85, audioCtx.currentTime);
                masterGainNode.connect(audioCtx.destination);
            }
        }
        if (audioCtx && (audioCtx.state === 'suspended' || audioCtx.state === 'interrupted')) {
            audioCtx.resume();
        }
        if (audioCtx && !audioUnlocked) {
            try {
                const buffer = audioCtx.createBuffer(1, 1, 22050);
                const source = audioCtx.createBufferSource();
                source.buffer = buffer;
                source.connect(audioCtx.destination);
                source.start(0);
                audioUnlocked = true;
            } catch (e) {
                console.warn("Buffer unlock warning", e);
            }
        }
    } catch(err) {
        console.warn("Audio unlock error:", err);
    }
}

function playChimeTone(pitch = 587.33, duration = 0.22) {
    unlockAudio();
    if (!audioCtx) return;
    try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(pitch, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.18, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
    } catch(e) {}
}

function primeAudioAndSpeechEngines() {
    unlockAudio();
    if (!('speechSynthesis' in window)) return;
    try {
        if (window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
        }
        if (!speechUnlocked) {
            window.speechSynthesis.cancel();
            const dummy = new SpeechSynthesisUtterance('');
            dummy.volume = 0;
            window.speechSynthesis.speak(dummy);
            window.speechSynthesis.resume();
            speechUnlocked = true;
        }
    } catch(e) {}
}

['touchstart', 'touchend', 'click', 'pointerdown'].forEach(evt => {
    document.addEventListener(evt, () => {
        primeAudioAndSpeechEngines();
    }, { passive: true, once: false });
});

