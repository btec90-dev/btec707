          <button class="min-h-[38px] px-3 py-1.5 rounded-xl font-medium transition text-gray-300 hover:text-white hover:bg-white/10 touch-manipulation" id="trimBtn3" onclick="jumpToTrimester(3)">
            T3 (S28-S40)
          </button>
        </div>
      </div>

      <!-- ASTUCE MOBILE IOS / ANDROID & DÉVERROUILLAGE VOCAL FIABLE -->
      <div class="mt-3 pt-2.5 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px] text-gray-300 font-light">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-xs text-amber-400">phonelink_ring</span>
          
        </div>
        <div class="flex items-center gap-3">
          
          
        </div>
