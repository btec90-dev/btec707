function playDopplerHeartbeat() {
    if (isAudioMuted) return;
    unlockAudio();
    if (!audioCtx) return;
    try {
        if (audioCtx.state === 'suspended' || audioCtx.state === 'interrupted') {
            audioCtx.resume();
        }
        const now = audioCtx.currentTime;
        triggerDopplerPulse(now, 82, 42, 0.16, 0.75);
        triggerDopplerPulse(now + 0.11, 102, 52, 0.13, 0.55);
    } catch(e) {
        console.warn("Heartbeat playback issue:", e);
    }
}

function triggerDopplerPulse(time, startFreq, endFreq, duration, volume) {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const filter = audioCtx.createBiquadFilter();
    osc.type = "sine";
    osc.frequency.setValueAtTime(startFreq, time);
    osc.frequency.exponentialRampToValueAtTime(endFreq, time + duration);
    filter.type = "lowpass";
    filter.frequency.setValueAtTime(260, time);
    filter.Q.setValueAtTime(2.5, time);
    gain.gain.setValueAtTime(volume, time);
    gain.gain.exponentialRampToValueAtTime(0.0001, time + duration);
    osc.connect(filter);
    filter.connect(gain);
    if (masterGainNode) {
        gain.connect(masterGainNode);
    } else {
        gain.connect(audioCtx.destination);
    }
    osc.start(time);
    osc.stop(time + duration);
}

function startHeartbeatLoop() {
    stopHeartbeatLoop();
    if (isAudioMuted) return;
    const idx = getCurrentStepIndex(currentSecond);
    const step = transcriptData[idx];
    let bpm = 145;
    if (step && step.bpm && step.bpm !== 'N/A') {
        const m = step.bpm.match(/\d+/);
        if (m) bpm = parseInt(m[0], 10);
    }
    const intervalMs = Math.max(380, Math.min(800, (60 / bpm) * 1000));
    playDopplerHeartbeat();
    heartbeatTimer = setInterval(playDopplerHeartbeat, intervalMs);
}

function stopHeartbeatLoop() {
    if (heartbeatTimer) {
        clearInterval(heartbeatTimer);
        heartbeatTimer = null;
    }
}

function speakMilestoneVoice(text, onCompleteCallback = null, forceSpeak = false) {
    if (!isSpeechEnabled && !forceSpeak) {
        if (onCompleteCallback) onCompleteCallback();
        return;
    }
    if (!('speechSynthesis' in window)) {
        playChimeTone();
        if (onCompleteCallback) onCompleteCallback();
        return;
    }
    try {
        primeAudioAndSpeechEngines();
        if (window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
        }
        if (forceSpeak || window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
        }
        const clean = text.replace(/["«»🔬🌱✨👶💙]/g, '').trim();
        const utterance = new SpeechSynthesisUtterance(clean);
        window._currentUtterance = utterance;
        if (!frenchVoices || frenchVoices.length === 0) {
            loadVoices();
        }
        let chosenVoice = null;
        if (frenchVoices && frenchVoices.length > 0) {
            chosenVoice = frenchVoices.find(v => v.name.toLowerCase().includes('google') && v.lang.startsWith('fr'))
                || frenchVoices.find(v => v.name.toLowerCase().includes('thomas') || v.name.toLowerCase().includes('amelie') || v.name.toLowerCase().includes('audrey'))
                || frenchVoices[0];
        } else if (allVoicesCache && allVoicesCache.length > 0) {
            chosenVoice = allVoicesCache.find(v => v.lang && v.lang.toLowerCase().startsWith('fr')) || allVoicesCache[0];
        }
        if (chosenVoice) {
            utterance.voice = chosenVoice;
            utterance.lang = chosenVoice.lang || 'fr-FR';
        } else {
            utterance.lang = 'fr-FR';
        }
        utterance.rate = 0.92;
        utterance.pitch = 1.0;
        utterance.volume = 1.0;
        let hasFinished = false;
        const finalizeUtterance = () => {
            if (hasFinished) return;
            hasFinished = true;
            isVoiceCurrentlySpeaking = false;
            window._currentUtterance = null;
            if (window._speechResumeWatchdog) {
                clearInterval(window._speechResumeWatchdog);
                window._speechResumeWatchdog = null;
            }
            const wave = document.getElementById("voiceSpeakingWave");
            if (wave) wave.classList.add('opacity-30');
            if (onCompleteCallback) onCompleteCallback();
        };
        utterance.onstart = () => {
            isVoiceCurrentlySpeaking = true;
            const wave = document.getElementById("voiceSpeakingWave");
            if (wave) wave.classList.remove('opacity-30');
        };
        utterance.onend = () => { finalizeUtterance(); };
        utterance.onerror = (err) => {
            console.warn("SpeechSynthesis error on mobile:", err);
            finalizeUtterance();
        };
        if (window._speechResumeWatchdog) clearInterval(window._speechResumeWatchdog);
        window._speechResumeWatchdog = setInterval(() => {
            if (window.speechSynthesis.speaking && window.speechSynthesis.paused) {
                window.speechSynthesis.resume();
            }
        }, 3000);
        window.speechSynthesis.resume();
        window.speechSynthesis.speak(utterance);
    } catch(e) {
        console.warn("Speech synthesis error caught:", e);
        isVoiceCurrentlySpeaking = false;
        window._currentUtterance = null;
        if (onCompleteCallback) onCompleteCallback();
    }
}

