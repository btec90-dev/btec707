function loadVoices() {
    if (!('speechSynthesis' in window)) return;
    try {
        const voices = window.speechSynthesis.getVoices();
        if (voices && voices.length > 0) {
            allVoicesCache = voices;
            frenchVoices = voices.filter(v => v.lang && (v.lang.toLowerCase().startsWith('fr') || v.lang.includes('FR')));
        }
    } catch(e) {}
}

let voiceRetryCount = 0;
function pollVoicesForAndroid() {
    loadVoices();
    if ((!frenchVoices || frenchVoices.length === 0) && voiceRetryCount < 15) {
        voiceRetryCount++;
        setTimeout(pollVoicesForAndroid, 250);
    }
}
if ('speechSynthesis' in window) {
    window.speechSynthesis.onvoiceschanged = () => { loadVoices(); };
    pollVoicesForAndroid();
}

function showAudioToast(title, msg, icon = "volume_up") {
