      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-mono text-gray-400 min-w-[55px]" id="scrubTime">00:00:01</span>
        <div class="relative flex-1 group py-2">
          <input class="w-full h-2.5 bg-mocha rounded-lg appearance-none cursor-pointer accent-bronze focus:outline-none touch-manipulation" id="timeSlider" max="862" min="1" oninput="seekToSeconds(parseInt(this.value))" step="1" type="range" value="1">
        </div>
        <span class="text-xs font-mono text-gray-400 min-w-[55px] text-right">00:14:22</span>
      </div>

      <!-- Boutons de commande tactiles mobile minimum 44px de hauteur -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
