    if (isPlaying) {
        pauseSimulation();
    } else {
        startSimulation();
    }
}

function startSimulation() {
    isPlaying = true;
    primeAudioAndSpeechEngines();
    const playIcon = document.getElementById("playIcon");
    const playLabel = document.getElementById("playLabel");
    const centerIcon = document.getElementById("centerPlayIcon");
    const centerWrapper = document.getElementById("centerPlayIconWrapper");
    if (playIcon) playIcon.innerText = "pause";
    if (playLabel) playLabel.innerText = "Pause";
    if (centerIcon) centerIcon.innerText = "pause";
    if (centerWrapper) {
        centerWrapper.classList.add('opacity-0', 'scale-90');
    }
    if (!isAudioMuted) {
        startHeartbeatLoop();
    }
    scheduleNextStep();
}

function scheduleNextStep() {
    if (stepAdvanceTimer) clearTimeout(stepAdvanceTimer);
    if (!isPlaying) return;
    const curIdx = getCurrentStepIndex(currentSecond);
    const stepData = transcriptData[curIdx];
    updateScreenDisplay(curIdx, false);
    const onSentenceFinished = () => {
        if (!isPlaying) return;
        stepAdvanceTimer = setTimeout(() => {
            if (!isPlaying) return;
            if (curIdx < transcriptData.length - 1) {
                currentSecond = transcriptData[curIdx + 1].seconds;
                scheduleNextStep();
            } else {
                pauseSimulation();
            }
        }, 1200);
    };
    if (isSpeechEnabled) {
        speakMilestoneVoice(`${stepData.week}. ${stepData.text}`, onSentenceFinished, false);
    } else {
        stepAdvanceTimer = setTimeout(onSentenceFinished, 5000);
    }
}

function pauseSimulation() {
    isPlaying = false;
    const playIcon = document.getElementById("playIcon");
    const playLabel = document.getElementById("playLabel");
    const centerIcon = document.getElementById("centerPlayIcon");
    const centerWrapper = document.getElementById("centerPlayIconWrapper");
    if (playIcon) playIcon.innerText = "play_arrow";
    if (playLabel) playLabel.innerText = "Lecture Simulation";
    if (centerIcon) centerIcon.innerText = "play_arrow";
    if (centerWrapper) {
        centerWrapper.classList.remove('opacity-0', 'scale-90');
    }
    if (stepAdvanceTimer) {
        clearTimeout(stepAdvanceTimer);
        stepAdvanceTimer = null;
    }
    stopHeartbeatLoop();
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        window._currentUtterance = null;
    }
    const wave = document.getElementById("voiceSpeakingWave");
    if (wave) wave.classList.add('opacity-30');
}

function nextStep() {
    primeAudioAndSpeechEngines();
    const curIdx = getCurrentStepIndex(currentSecond);
    if (curIdx < transcriptData.length - 1) {
        seekToSeconds(transcriptData[curIdx + 1].seconds);
        speakMilestoneVoice(`${transcriptData[curIdx + 1].week}. ${transcriptData[curIdx + 1].text}`, null, true);
    }
}

function prevStep() {
    primeAudioAndSpeechEngines();
    const curIdx = getCurrentStepIndex(currentSecond);
    if (curIdx > 0) {
        seekToSeconds(transcriptData[curIdx - 1].seconds);
        speakMilestoneVoice(`${transcriptData[curIdx - 1].week}. ${transcriptData[curIdx - 1].text}`, null, true);
    }
}

function jumpToTrimester(trim) {
    primeAudioAndSpeechEngines();
    let targetSec = 1;
    if (trim === 1) targetSec = 1;
    else if (trim === 2) targetSec = 210;
    else if (trim === 3) targetSec = 630;
    const btn1 = document.getElementById("trimBtn1");
    const btn2 = document.getElementById("trimBtn2");
    const btn3 = document.getElementById("trimBtn3");
    [btn1, btn2, btn3].forEach(b => {
        if (b) {
            b.classList.remove("bg-bronze", "text-white");
            b.classList.add("text-gray-300");
        }
    });
    const cur = document.getElementById(`trimBtn${trim}`);
    if (cur) {
        cur.classList.remove("text-gray-300");
        cur.classList.add("bg-bronze", "text-white");
    }
    seekToSeconds(targetSec);
    const curIdx = getCurrentStepIndex(targetSec);
    speakMilestoneVoice(`${transcriptData[curIdx].week}. ${transcriptData[curIdx].text}`, null, true);
}

/* =========================================================
   5. GÉNÉRATION DES JALONS DE LA VIDÉO
========================================================= */
function renderTranscriptFeed() {
    const feed = document.getElementById("transcriptFeed");
    if (!feed) return;
    feed.innerHTML = "";
    transcriptData.forEach((item, idx) => {
        const row = document.createElement("div");
        row.id = `row-${idx}`;
        row.className = "transcript-row min-h-[44px] p-2.5 rounded-xl border border-sand bg-cream/50 hover:bg-sand/40 cursor-pointer transition flex items-center justify-between text-xs touch-manipulation";
        row.onclick = () => {
            primeAudioAndSpeechEngines();
            seekToSeconds(item.seconds);
            speakMilestoneVoice(`${item.week}. ${item.text}`, null, true);
        };
        row.innerHTML = `
            <div class="flex items-center gap-2.5">
                <span class="font-mono text-bronze-dark font-bold bg-sand px-2 py-0.5 rounded">${item.timeStr}</span>
                <span class="font-bold text-mocha">${item.week}</span>
                <span class="text-mocha-light hidden md:inline truncate max-w-md">${item.stage}</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-rose-700 font-mono font-medium">${item.bpm}</span>
                <span class="text-[11px] text-mocha-light">${item.fruit}</span>
            </div>
        `;
        feed.appendChild(row);
    });
}

document.addEventListener("DOMContentLoaded", () => {
    renderTranscriptFeed();
    updateScreenDisplay(0, false);
    pollVoicesForAndroid();
    updateSpeechButtonUI();
    updateSoundButtonUI();
});
</script>



