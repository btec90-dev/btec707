  <!-- JALONS CLÉS ET TRANSCRIPT DE LA VIDÉO -->
  <div class="bg-ivory border border-sand rounded-3xl p-5 sm:p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3.5 border-b border-sand gap-2">
      <div>
        <h2 class="font-serif text-lg sm:text-xl font-bold text-mocha flex items-center gap-2">
          <span class="material-symbols-outlined text-bronze">timeline</span>
