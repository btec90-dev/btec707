        </div>
      </div>

      <!-- Métriques Télémétriques In-Utero -->
      <div class="absolute top-3 left-3 z-20 flex flex-col gap-1 bg-black/60 backdrop-blur-md p-2.5 rounded-2xl border border-white/15 text-left pointer-events-none">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-rose-400 text-xs sm:text-sm animate-heartbeat">favorite</span>
