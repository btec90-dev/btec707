          </span>
          <span class="text-emerald-300 text-[11px] font-medium hidden sm:inline" id="audioStateText">Doppler &amp; Voix Prêts</span>
          <div class="flex items-center gap-0.5 h-3 transition-opacity" id="voiceSpeakingWave">
            <div class="w-1 bg-amber-400 rounded-full animate-wave" style="animation-delay: 0.1s;"></div>
            <div class="w-1 bg-amber-300 rounded-full animate-wave" style="animation-delay: 0.3s;"></div>
            <div class="w-1 bg-amber-400 rounded-full animate-wave" style="animation-delay: 0.2s;"></div>
          </div>
        </div>
        <div class="bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/10 text-xs font-mono text-amber-300 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span id="currentTimeDisplay" class="">00:00:01</span> / <span class="">00:14:22</span>
        </div>
      </div>
    </div>

    <!-- BARRE DE CONTRÔLE INTERACTIVE -->
    <div class="p-4 sm:p-5 bg-[#251b15] border-t border-white/10">
