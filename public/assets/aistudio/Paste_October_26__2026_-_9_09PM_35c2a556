    <div class="mt-4 max-h-[380px] overflow-y-auto space-y-2 custom-scrollbar pr-2" id="transcriptFeed"><div id="row-0" class="transcript-row min-h-[44px] p-2.5 rounded-xl border border-sand bg-cream/50 hover:bg-sand/40 cursor-pointer transition flex items-center justify-between text-xs touch-manipulation bg-bronze/20 border-bronze">
