<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport"><title>Mon Parcours FIV — Fatou</title>
<style>
:root{--gold:#6f4e37;--gold2:#a88164;--cream:#f8f4ef;--paper:#fffefe;--ink:#2b2320;--muted:#6e6460;--line:#e3d7cb;--green:#357a61;--rose:#b85e6f;--purple:#7a6396}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--ink);font:14.5px/1.5 Inter,system-ui,-apple-system,sans-serif;padding-top:68px;padding-bottom:30px}
.shell{display:block;min-height:100vh}
.side{display:none}

/* Navigation fixe en haut */
#mobile-nav{
  position:fixed!important;
  top:0!important;
  left:0!important;
  right:0!important;
  width:100%!important;
  z-index:9999!important;
  backdrop-filter:blur(16px)!important;
  -webkit-backdrop-filter:blur(16px)!important;
  background:rgba(248,244,239,0.98)!important;
  box-shadow:0 2px 10px rgba(43,35,32,0.1)!important;
  border-bottom:1px solid #e3d7cb!important;
  display:flex!important;
  justify-content:space-around!important;
  align-items:center!important;
  padding:8px 4px!important;
  box-sizing:border-box!important;
}
.mobile-nav-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  color:#7e7169;
  text-decoration:none;
  font-size:10.5px;
  font-weight:600;
  padding:4px 8px;
  border-radius:10px;
  transition:all .18s ease;
  min-width:54px;
}
.mobile-nav-item span.icon{font-size:17px;line-height:1.1;margin-bottom:2px}
.mobile-nav-item.active,.mobile-nav-item:hover{color:#5c3b24;background:#f0e2d4}

main{padding:14px 14px 40px;max-width:760px;margin:0 auto}

/* Mobile brand header */
.mobile-top-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:16px;
  padding:12px 16px;
  margin-bottom:14px;
  box-shadow:0 3px 12px rgba(93,71,32,0.05);
}
.mobile-brand{display:flex;align-items:center;gap:10px}
.mobile-brand .heart{font-size:24px;color:var(--gold);line-height:1}
.mobile-brand h2{font:600 17px Georgia,serif;margin:0;color:var(--ink)}
.mobile-brand small{font-size:11px;color:var(--gold);font-style:italic;font-weight:600}
.privacy-badge{
  font-size:11px;
  font-weight:700;
  padding:4px 10px;
  border-radius:20px;
  background:#f4ebd8;
  color:#5c3b24;
  border:1px solid #e3d7cb;
  display:inline-flex;
  align-items:center;
  gap:4px;
}

/* Hero & Clinic profile */
.hero{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:20px}
.banner{
  border:1px solid #d9c8b7;
  border-radius:20px;
  padding:22px 18px;
  background:linear-gradient(110deg,#ecdccf,#fcf9f5 65%,#e5d2c2);
  position:relative;
  overflow:hidden;
}
.banner:after{content:'♡';position:absolute;right:14px;bottom:-35px;font:130px Georgia;color:rgba(111,78,55,0.08);pointer-events:none}
.kicker{font-size:10.5px;letter-spacing:1.8px;text-transform:uppercase;font-weight:800;color:#5c3b24}
.banner h1{font:500 24px/1.22 Georgia,serif;margin:8px 0;color:#2b2320;position:relative;z-index:1}
.banner p{color:#5c524c;font-size:12.5px;line-height:1.5;margin:0;position:relative;z-index:1}

.profile{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:16px;
  padding:15px;
  box-shadow:0 4px 16px rgba(93,71,32,0.05);
}
.profile h3{margin:0 0 10px;font:20px Georgia,serif;color:#5c3b24}
.profile-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.profile-item{background:#fdfaf6;border:1px solid #ebdccb;border-radius:10px;padding:9px 10px}
.profile-item span{display:block;font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;font-weight:700}
.profile-item b{font-size:12.5px;color:var(--ink);display:block;margin-top:2px}

.section{margin-top:22px}
.heading{margin-bottom:12px}
.heading h2{font:500 22px Georgia,serif;margin:4px 0 2px;color:#2b2320}
.heading p{color:var(--muted);font-size:12px;margin:0}

/* Stats */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:15px;
  padding:14px;
  box-shadow:0 3px 12px rgba(93,71,32,0.05);
}
.stat .icon{font-size:22px}
.stat strong{display:block;font:30px Georgia,serif;color:#5c3b24;margin-top:4px;line-height:1.1}
.stat span{font-size:11.5px;color:var(--muted);font-weight:600}

/* Checklist */
.panel{background:var(--paper);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(93,71,32,0.05)}
.panelhead{
  padding:12px 16px;
  background:linear-gradient(90deg,#f0e4d7,#fdf8f4);
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.panelhead h3{font:500 17px Georgia,serif;color:#5c3b24;margin:0}
.badge{background:#ebdccf;color:#543722;border-radius:30px;padding:3px 9px;font-size:10px;font-weight:800}

.checks{padding:4px 14px}
.check{
  display:flex;
  gap:11px;
  padding:12px 0;
  border-bottom:1px solid #f1e7db;
  align-items:flex-start;
  cursor:pointer;
}
.check:last-child{border:0}
.check input{accent-color:var(--gold);margin-top:3px;transform:scale(1.15);cursor:pointer}
.check .sym{font-size:18px;line-height:1.2}
.check strong{font-size:13px;display:block;color:#2b2320}
.check small{display:block;color:#5c3b24;font-size:10px;text-transform:uppercase;font-weight:800;letter-spacing:.4px;margin-bottom:2px}
.check p{font-size:11.5px;color:var(--muted);margin:3px 0 0;line-height:1.45}
.check.completed strong{text-decoration:line-through;color:var(--muted)}
.check.completed p{opacity:0.65}
.check-badge{display:inline-block;border-radius:12px;padding:2px 7px;font-size:9px;font-weight:700;margin-left:5px;vertical-align:middle}
.check-badge.updated{background:#fde8cf;color:#a05d15}
.check-badge.done{background:#e3f1e8;color:#287454}
.check-badge.pending{background:#e6eff8;color:#284b5e}

.countdown-badge{
  display:inline-flex;
  align-items:center;
  gap:3px;
  padding:2px 7px;
  border-radius:999px;
  font-size:0.72rem;
  font-weight:750;
  white-space:nowrap;
  vertical-align:middle;
}
.cd-past{background:#e9f3ec;color:#1f644b;border:1px solid #b7dfce}
.cd-today{background:#f6ecdf;color:#5c3a21;border:1px solid #dcc2a8;font-weight:800}
.cd-imminent{background:#fce8eb;color:#94253a;border:1px solid #f3b5c1;font-weight:800}
.cd-future{background:#eaf1f7;color:#1c5286;border:1px solid #bdd7f2;font-weight:700}
.cd-pending{background:#f5ede4;color:#614631;border:1px solid #e0d0c1;font-weight:600}

/* Calendrier */
.calendar{padding:14px}
.calhead{display:flex;justify-content:space-between;align-items:center}
.calhead h3{font:19px Georgia,serif;color:#5c3b24;margin:0}
.calhead button{background:white;border:1px solid var(--line);color:var(--gold);border-radius:8px;padding:5px 12px;cursor:pointer;font-weight:700}
.week,.days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;margin-top:10px}
.week span{text-align:center;font-size:10.5px;color:var(--muted);font-weight:600}
.day{
  border:1px solid transparent;
  background:transparent;
  border-radius:8px;
  min-height:34px;
  position:relative;
  font-size:11.5px;
  color:var(--ink);
  cursor:pointer;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
}
.day.event{background:#f7eee4;border-color:#e5d4c3;font-weight:800}
.day.done{background:#eaf4ed;border-color:#d4e7d9}
.day.sel{background:var(--gold)!important;color:white!important}
.day i{position:absolute;bottom:3px;left:calc(50% - 2px);width:4px;height:4px;border-radius:50%;background:var(--gold)}
.day.done i{background:var(--green)}
.cal-detail-card{margin-top:12px;padding:12px;background:#fcf9f5;border:1px solid var(--line);border-radius:10px}
.detail{font-size:12px;color:var(--ink);margin:0;line-height:1.45}
.detail-action{margin-top:10px;display:flex;align-items:center;gap:8px}
.detail-btn{background:white;border:1px solid var(--gold);color:var(--gold);border-radius:8px;padding:6px 12px;font-size:11.5px;font-weight:700;cursor:pointer}
.detail-btn.is-done{background:#e8f4ed;border-color:var(--green);color:var(--green)}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:10.5px;color:var(--muted);margin-top:10px}
.legend span{display:flex;align-items:center;gap:5px}
.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--gold)}

/* Notice */
.notice{margin-top:14px;border:1px solid #dfcfbe;background:#fbf6f0;color:#523f33;border-radius:12px;padding:12px;font-size:11.5px;line-height:1.45}

/* Phases */
.phasegrid{display:grid;grid-template-columns:1fr;gap:10px}
.phase{background:var(--paper);border:1px solid var(--line);border-radius:15px;padding:14px;box-shadow:0 3px 12px rgba(93,71,32,0.05)}
.phase-header{display:flex;align-items:center;justify-content:space-between}
.phase .num{background:linear-gradient(135deg,#5c3b24,#9d7759);color:white;border-radius:50%;display:inline-grid;place-items:center;width:30px;height:30px;font-weight:800;font-size:13px}
.phase .pic{font-size:22px}
.phase h3{font-size:14.5px;margin:10px 0 4px;color:#2b2320}
.phase p{font-size:11.5px;color:var(--muted);margin:0}
.status{display:inline-block;border-radius:20px;padding:3px 8px;font-size:10px;font-weight:800;margin-top:8px;background:#e3f1e8;color:#287454}
.status.active{background:#f4e9dd;color:#5c3b24}
.status.future{background:#edf0f2;color:#67747c}

/* Timelines */
.timelinegrid{display:grid;grid-template-columns:1fr;gap:12px}
.timeline{background:var(--paper);border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:0 3px 12px rgba(93,71,32,0.05)}
.t-head{padding:10px 14px;background:#eee1d3;color:#543722;font-size:11px;font-weight:800;letter-spacing:.3px}
.t-head.green{background:#e8f2e9;color:#347a5c}
.t-head.gray{background:#f0f0ee;color:#67747c}
.items{padding:8px 12px}
.item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid #f1e8dc;font-size:11px}
.item:last-child{border:0}
.item time{font-weight:800;color:#5c3b24;min-width:70px}
.item p{margin:0;color:#49545a;flex:1}
.item.interactive-item{cursor:pointer;border-radius:6px;padding:7px 5px}
.item.is-completed{background:#eef7f1!important}
.t-toggle-btn{background:#fff8ee;border:1px solid #e1cfaf;color:#8e6b29;font-size:9.5px;font-weight:700;border-radius:8px;padding:3px 7px;cursor:pointer}
.t-toggle-btn.done{background:#e3f1e8;border-color:#b4dec3;color:#287454}

/* Journal */
.journal-layout{display:grid;grid-template-columns:1fr;gap:14px}
.journal-card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:0 4px 16px rgba(93,71,32,0.05)}
.journal-form-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid var(--line);padding-bottom:10px}
.journal-form-header h3{font:500 17px Georgia,serif;color:#5c3b24;margin:0}
.journal-mode-badge{font-size:10px;padding:3px 8px;border-radius:20px;font-weight:700;background:#f4e9dd;color:#5c3b24}
.journal-field{margin-bottom:11px}
.journal-field label{display:block;font-size:10.5px;font-weight:700;color:#67747c;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.journal-input,.journal-select,.journal-textarea{
  width:100%;
  border:1px solid var(--line);
  background:#fffefb;
  border-radius:9px;
  padding:9px 11px;
  font-size:13px;
  color:var(--ink);
  font-family:inherit;
  outline:none;
}
.journal-textarea{resize:vertical;min-height:90px;line-height:1.45}
.journal-row{display:grid;grid-template-columns:1fr;gap:10px}
.journal-actions{display:flex;gap:8px;margin-top:12px}
.btn-journal-save{
  background:linear-gradient(100deg,#6f4e37,#8d6648);
  color:white;
  border:none;
  padding:10px 16px;
  border-radius:9px;
  font-size:12.5px;
  font-weight:700;
  cursor:pointer;
  flex:1;
}
.btn-journal-cancel{background:white;border:1px solid var(--line);color:var(--muted);padding:10px 14px;border-radius:9px;font-size:12px;cursor:pointer}
.entries-container{display:grid;gap:12px}
.entry-card{background:var(--paper);border:1px solid var(--line);border-radius:15px;padding:15px;box-shadow:0 3px 12px rgba(93,71,32,0.05)}
.entry-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:6px}
.entry-cat{font-size:10px;font-weight:700;padding:2px 8px;border-radius:12px}
.cat-emotion{background:#fdebf0;color:#aa4b64}
.cat-medical{background:#e7f0f8;color:#2c5b7c}
.cat-milestone{background:#e5f4ec;color:#287454}
.entry-date{font-size:11px;color:var(--muted)}
.entry-card h4{font:500 16px Georgia,serif;color:#34414b;margin:0 0 5px}
.entry-text{font-size:12px;color:#526068;line-height:1.5;margin:0}
.entry-footer{display:flex;justify-content:flex-end;gap:8px;margin-top:10px;padding-top:8px;border-top:1px dashed #efe4d3}
.entry-btn{background:white;border:1px solid #ebdcc5;font-size:10.5px;padding:4px 9px;border-radius:7px;color:#6d7981;cursor:pointer}

/* Footer */
.footer{
  border-top:1px solid var(--line);
  margin-top:30px;
  padding-top:18px;
  display:flex;
  flex-direction:column;
  gap:10px;
  align-items:center;
  text-align:center;
  color:var(--muted);
  font-size:11.5px;
}
.footer em{font:italic 18px Georgia,serif;color:#6f4e37}
.footer button{border:1px solid var(--line);border-radius:30px;background:#fbf6f0;color:#543722;padding:8px 16px;cursor:pointer;font-weight:600}
</style></head>
