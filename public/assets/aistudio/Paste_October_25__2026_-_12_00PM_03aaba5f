  const title = document.getElementById("note-title").value.trim();
  const date = document.getElementById("note-date").value;
  const category = document.getElementById("note-cat").value;
  const content = document.getElementById("note-content").value.trim();
  if (!title || !content) return;

  if (editingNoteId) {
    const idx = journalNotes.findIndex(n => n.id === editingNoteId);
    if (idx !== -1) journalNotes[idx] = { id: editingNoteId, title, date, category, content };
  } else {
    journalNotes.unshift({ id: "note-" + Date.now(), title, date, category, content });
  }
  saveNotesToStorage();
  renderJournalEntries();
  resetNoteForm();
}

function editNote(id) {
  const n = journalNotes.find(item => item.id === id);
  if (!n) return;
  editingNoteId = id;
  document.getElementById("note-title").value = n.title;
  document.getElementById("note-date").value = n.date;
  document.getElementById("note-cat").value = n.category;
  document.getElementById("note-content").value = n.content;
  document.getElementById("form-heading").innerHTML = "<span>✏️</span> Modifier le mémo";
  document.getElementById("btn-save-label").textContent = "Mettre à jour";
  document.getElementById("form-mode-badge").style.display = "inline-block";
}

function deleteNote(id) {
  if (confirm("Supprimer cette note ?")) {
    journalNotes = journalNotes.filter(n => n.id !== id);
    if (editingNoteId === id) resetNoteForm();
    saveNotesToStorage();
    renderJournalEntries();
  }
}

function resetNoteForm() {
  editingNoteId = null;
  const f = document.getElementById("journal-form");
  if (f) f.reset();
  const dInput = document.getElementById("note-date");
  if (dInput) dInput.value = "2026-10-28";
  document.getElementById("form-heading").innerHTML = "<span>✍</span> Nouvelle note";
  document.getElementById("btn-save-label").textContent = "Enregistrer le mémo";
  document.getElementById("form-mode-badge").style.display = "none";
}

function setActiveTab(el) {
  document.querySelectorAll('.mobile-nav-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
}

// Initialisations
render();
resetNoteForm();
renderJournalEntries();
</script>


